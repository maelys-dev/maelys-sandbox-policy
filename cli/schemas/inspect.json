{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inspectionVersion",
    "mirFormatVersion",
    "identity",
    "filesystem",
    "network",
    "root",
    "process"
  ],
  "properties": {
    "inspectionVersion": {
      "const": 1
    },
    "mirFormatVersion": {
      "const": 3
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "basis",
        "decisionDigest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "basis": {
          "const": "canonical-mir-v3-bytes"
        },
        "decisionDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "rules"
      ],
      "properties": {
        "default": {
          "const": "deny"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "access",
              "root",
              "path",
              "scope",
              "missing"
            ],
            "properties": {
              "access": {
                "enum": [
                  "read",
                  "write",
                  "deny",
                  "deny-write"
                ]
              },
              "root": {
                "enum": [
                  "minimal-runtime",
                  "workspace",
                  "temp",
                  "host"
                ]
              },
              "path": {
                "type": "string"
              },
              "scope": {
                "enum": [
                  "exact",
                  "tree"
                ]
              },
              "missing": {
                "enum": [
                  "error",
                  "skip"
                ]
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "direct",
            "mediated"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "host",
              "port"
            ],
            "properties": {
              "protocol": {
                "const": "tcp"
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "requireTlsSni": {
                "const": true
              },
              "allowPrivateAddresses": {
                "const": true
              }
            }
          }
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "read-only",
            "ephemeral-write"
          ]
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treeConfinement"
      ],
      "properties": {
        "treeConfinement": {
          "enum": [
            "required",
            "disabled"
          ]
        }
      }
    }
  }
}
