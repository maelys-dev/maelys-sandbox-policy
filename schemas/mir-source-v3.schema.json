{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.maelys.dev/mir-source/v3/schema.json",
  "title": "Maelys Sandbox Policy MIR source v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "filesystem", "network", "process", "root"],
  "properties": {
    "$schema": {"const": "https://schemas.maelys.dev/mir-source/v3/schema.json"},
    "formatVersion": {"const": 3},
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["read-only", "ephemeral-write"]}}
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "rules"],
      "properties": {
        "default": {"const": "deny"},
        "rules": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/fsRule"}
        }
      }
    },
    "network": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"enum": ["none", "direct"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allow"],
          "properties": {
            "mode": {"const": "mediated"},
            "allow": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {"$ref": "#/$defs/networkDestination"}
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeConfinement"],
      "properties": {"treeConfinement": {"enum": ["required", "disabled"]}}
    }
  },
  "$defs": {
    "networkDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "host", "port"],
      "properties": {
        "protocol": {"const": "tcp"},
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?=.{1,253}$)(?!-)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?!-)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "fsRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "path"],
      "properties": {
        "access": {"enum": ["read", "write", "deny"]},
        "scope": {"enum": ["exact", "tree"], "default": "tree"},
        "missing": {"enum": ["error", "skip"], "default": "error"},
        "path": {"$ref": "#/$defs/path"}
      }
    },
    "path": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["special"],
          "properties": {"special": {"const": "minimal-runtime"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["root"],
          "properties": {
            "root": {"enum": ["workspace", "temp"]},
            "relative": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["absolute"],
          "properties": {
            "absolute": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^/"
            }
          }
        }
      ]
    }
  }
}
